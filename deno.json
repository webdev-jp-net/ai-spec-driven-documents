{
  "nodeModulesDir": "auto",
  "imports": {
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/yaml": "jsr:@std/yaml@^1.0.0",
    "@std/json": "jsr:@std/json@^1.0.0",
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@^0.5.0",
    "zod": "npm:zod@^3.25.51"
  },
  "tasks": {
    "mcp:start": "deno run --allow-env --allow-read=.,_llm-docs,_llm-rules,_llm-memories --allow-write=_llm-memories --allow-net=api.github.com --allow-run=gh --allow-sys=homedir tools/mcp-server/server.ts",
    "mcp:test": "deno test --allow-env --allow-read=.,_llm-docs,_llm-rules,_llm-memories --allow-write=_llm-memories --allow-net=api.github.com --allow-run=gh --allow-sys=homedir tools/mcp-server/",
    "issue:sync": "deno run --allow-env --allow-read=.,_llm-memories --allow-write=_llm-memories --allow-net=api.github.com --allow-run=gh tools/mcp-server/handlers/github-sync.ts",
    "format": "deno fmt tools/mcp-server/",
    "lint": "deno lint tools/mcp-server/"
  },
  "fmt": {
    "include": ["tools/mcp-server/", "tools/issue-manager/"],
    "exclude": ["node_modules/", ".git/", "_llm-memories/"]
  },
  "lint": {
    "include": ["tools/mcp-server/", "tools/issue-manager/"],
    "exclude": ["node_modules/", ".git/", "_llm-memories/"]
  },
  "compilerOptions": {
    "lib": ["deno.ns", "deno.window"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "exclude": ["node_modules/", ".git/", "_llm-memories/"]
}
